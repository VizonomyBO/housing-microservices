# syntax=docker/dockerfile:1.7

FROM python:3.13-slim AS builder
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev git curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY packages ./packages
COPY services/agent-api ./services/agent-api
WORKDIR /app/services/agent-api
RUN uv sync --all-extras --frozen

FROM python:3.13-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
ENV APP_HOME=/app/services/agent-api \
    PATH="${APP_HOME}/.venv/bin:${PATH}" \
    PYTHONPATH="${APP_HOME}/src" \
    REDUCED_SCOPE_ENABLED=1 \
    AGENT_API_PORT=8000 \
    DATABASE_URL="postgresql+asyncpg://agent_api:agent_api@postgres:5432/housing" \
    UV_PROJECT_ENV="${APP_HOME}/.venv"
RUN useradd --create-home --shell /bin/bash agent
WORKDIR ${APP_HOME}
COPY --from=builder /app/packages ./../packages
COPY --from=builder /app/services/agent-api ${APP_HOME}
USER agent
EXPOSE 8000
ENTRYPOINT ["uv"]
CMD ["run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src", "--workers", "2"]
