FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_SYSTEM_PYTHON=1

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY services/agent-api/pyproject.toml /app/pyproject.toml
# Use the pinned lock to mirror local dev environments
COPY services/agent-api/uv.lock /app/uv.lock

# Copy shared data layer for editable install
COPY packages/shared_data_layer /app/packages/shared_data_layer

RUN uv venv /app/.venv && \
    . /app/.venv/bin/activate && \
    uv sync --all-extras

COPY services/agent-api/src /app/src

ENV PYTHONPATH=/app/src:/app/packages

EXPOSE 8000

CMD ["/bin/sh", "-c", ". /app/.venv/bin/activate && uv run uvicorn main:app --host 0.0.0.0 --port 8000"]
