FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_SYSTEM_PYTHON=1 \
    DENO_INSTALL=/root/.deno

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        unzip \
        build-essential \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-wheel \
        python3-cffi \
        libcairo2 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libgdk-pixbuf-2.0-0 \
        libffi-dev \
        shared-mime-info \
    && curl -fsSL https://deno.land/install.sh | sh \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

ENV PATH="${DENO_INSTALL}/bin:${PATH}"

WORKDIR /app/services/agent-api

COPY services/agent-api/pyproject.toml /app/services/agent-api/pyproject.toml
# Use the pinned lock to mirror local dev environments
COPY services/agent-api/uv.lock /app/services/agent-api/uv.lock

# Copy shared data layer for editable install (resolved from ../../packages in pyproject)
COPY packages/shared_data_layer /app/packages/shared_data_layer

COPY services/agent-api/src /app/services/agent-api/src

# Create the virtualenv inside the project directory to match uv's defaults
ENV VENV_PATH=/app/services/agent-api/.venv
RUN uv venv ${VENV_PATH} && \
    . ${VENV_PATH}/bin/activate && \
    uv sync --all-extras --frozen && \
    ${VENV_PATH}/bin/python -m ensurepip && \
    ${VENV_PATH}/bin/pip install --no-cache-dir python-multipart

ENV PYTHONPATH=/app/services/agent-api/src:/app/packages

EXPOSE 8000

CMD ["/bin/sh", "-c", ". ${VENV_PATH}/bin/activate && uv run uvicorn main:app --host 0.0.0.0 --port 8000"]
