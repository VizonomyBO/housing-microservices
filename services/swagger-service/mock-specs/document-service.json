{
  "openapi": "3.0.0",
  "info": {
    "title": "Document Service API",
    "version": "2.0.0",
    "description": "Document ingestion and management API (AWS Lambda). Simplified flow - no manual hash calculation required!"
  },
  "servers": [
    {
      "url": "https://z1xfknvwo3.execute-api.us-east-1.amazonaws.com/dev",
      "description": "AWS API Gateway (dev)"
    }
  ],
  "paths": {
    "/v1/documents/upload": {
      "post": {
        "summary": "Upload Document",
        "description": "**Simplified Upload Flow:**\n\n1. Call this endpoint with document metadata (name, type, size)\n2. Receive a presigned S3 URL\n3. Upload your file directly to S3 using the presigned URL\n4. System automatically calculates hash and checks for duplicates\n5. If new: document is processed through the ingestion pipeline\n6. If duplicate: returns existing document reference\n\n**No manual hash calculation required!**",
        "operationId": "uploadDocument",
        "tags": ["Documents"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUploadRequest"
              },
              "examples": {
                "pdf_upload": {
                  "summary": "PDF Document Upload",
                  "value": {
                    "document_name": "ARG_1988_Housing Finance Subsidies",
                    "source_type": "pdf",
                    "country_code": "ARG",
                    "language": "en",
                    "tags": ["housing", "finance", "subsidies"],
                    "file_size_bytes": 1841305,
                    "access_scope": "user_private"
                  }
                },
                "docx_upload": {
                  "summary": "Word Document Upload",
                  "value": {
                    "document_name": "Policy Report 2024",
                    "source_type": "docx",
                    "country_code": "USA",
                    "language": "en",
                    "tags": ["policy", "report"],
                    "file_size_bytes": 524288,
                    "access_scope": "user_private"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document registered - use the presigned URL to upload your file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                },
                "example": {
                  "document_id": "ca59795a-04f2-4a5a-ab4b-e0a5616d5fe5",
                  "status": "UPLOADING",
                  "upload": {
                    "url": "https://vizonomy-raw-docs-dev-xxx.s3.amazonaws.com/",
                    "fields": {
                      "key": "raw/ca59795a-04f2-4a5a-ab4b-e0a5616d5fe5/source.pdf",
                      "Content-Type": "application/pdf",
                      "AWSAccessKeyId": "ASIA...",
                      "policy": "eyJ...",
                      "signature": "..."
                    },
                    "expires_in_sec": 900
                  },
                  "message": "Upload your file to the presigned URL. After upload, the system will automatically validate and process your document.",
                  "request_id": "abc123"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Invalid source_type: exe",
                    "details": {
                      "field": "source_type",
                      "allowed": ["pdf", "docx", "doc", "txt", "md", "html", "csv", "xlsx", "json"]
                    },
                    "request_id": "abc123"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Missing user_id in authorization context",
                    "details": {},
                    "request_id": "abc123"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "Only admin/service roles can create base documents",
                    "details": {},
                    "request_id": "abc123"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/{document_id}": {
      "get": {
        "summary": "Get Document Status",
        "description": "Get the current status of a document. Use this to poll for processing completion after uploading.",
        "operationId": "getDocumentStatus",
        "tags": ["Documents"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Document ID returned from upload endpoint"
          }
        ],
        "responses": {
          "200": {
            "description": "Document status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from auth-service /v1/auth/login endpoint"
      }
    },
    "schemas": {
      "DocumentUploadRequest": {
        "type": "object",
        "required": ["document_name", "source_type", "file_size_bytes"],
        "properties": {
          "document_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Human-readable document name",
            "example": "ARG_1988_Housing Finance Subsidies"
          },
          "source_type": {
            "type": "string",
            "enum": ["pdf", "docx", "doc", "txt", "md", "html", "csv", "xlsx", "json"],
            "description": "File type/extension",
            "example": "pdf"
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104857600,
            "description": "File size in bytes (max 100MB)",
            "example": 1841305
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2,3}$",
            "description": "ISO country code (optional)",
            "example": "ARG"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "default": "en",
            "description": "ISO 639-1 language code",
            "example": "en"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Document tags for categorization",
            "example": ["housing", "finance", "subsidies"]
          },
          "access_scope": {
            "type": "string",
            "enum": ["user_private", "org_shared", "base"],
            "default": "user_private",
            "description": "Document visibility scope. 'base' requires admin/service role.",
            "example": "user_private"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Additional metadata key-value pairs",
            "example": {}
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook URL to call when processing completes"
          }
        }
      },
      "DocumentUploadResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique document identifier",
            "example": "ca59795a-04f2-4a5a-ab4b-e0a5616d5fe5"
          },
          "status": {
            "type": "string",
            "enum": ["UPLOADING"],
            "description": "Initial status - changes after S3 upload completes",
            "example": "UPLOADING"
          },
          "upload": {
            "type": "object",
            "description": "S3 presigned POST details - use this to upload your file",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "S3 bucket URL for POST upload"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Form fields to include in POST request"
              },
              "expires_in_sec": {
                "type": "integer",
                "description": "Seconds until presigned URL expires",
                "example": 900
              }
            }
          },
          "message": {
            "type": "string",
            "description": "Instructions for next step"
          },
          "request_id": {
            "type": "string",
            "description": "Request tracking ID"
          }
        }
      },
      "DocumentStatusResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["UPLOADING", "PENDING_VALIDATION", "PROCESSING", "COMPLETED", "DEDUPED", "FAILED"],
            "description": "Current document status"
          },
          "content_hash": {
            "type": "string",
            "description": "SHA-256 hash (available after upload)",
            "nullable": true
          },
          "deduped_from": {
            "type": "string",
            "format": "uuid",
            "description": "If DEDUPED, the ID of the original document",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message"
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "description": "Additional error details"
              },
              "request_id": {
                "type": "string",
                "description": "Request tracking ID"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Documents",
      "description": "Document upload and management operations"
    }
  ]
}
