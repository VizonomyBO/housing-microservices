{
  "openapi": "3.0.0",
  "info": {
    "title": "Swagger Aggregator Service",
    "version": "1.0.0",
    "description": "Centralized API documentation portal for microservices",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Aggregator Service"
    },
    {
      "url": "http://localhost:5001",
      "description": "Account Service - User authentication and account management service"
    }
  ],
  "paths": {
    "/v1/auth/register": {
      "post": {
        "summary": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/account-service_RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response"
          }
        },
        "tags": [
          "Account Service"
        ]
      },
      "servers": [
        {
          "url": "http://localhost:5001",
          "description": "Account Service - User authentication and account management service"
        }
      ]
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/account-service_LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        },
        "tags": [
          "Account Service"
        ]
      },
      "servers": [
        {
          "url": "http://localhost:5001",
          "description": "Account Service - User authentication and account management service"
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "account-service_RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "description": "Username (3-80 characters)"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "User password (minimum 8 characters)"
          },
          "first_name": {
            "type": "string",
            "nullable": true,
            "description": "User's first name"
          },
          "last_name": {
            "type": "string",
            "nullable": true,
            "description": "User's last name"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "USA",
            "description": "ISO country code (3 uppercase letters)"
          },
          "role": {
            "type": "string",
            "pattern": "^(admin|public|government|staff)$",
            "default": "public",
            "description": "User role"
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ]
      },
      "account-service_LoginRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "description": "Email address or username"
          },
          "password": {
            "type": "string",
            "description": "User password"
          }
        },
        "required": [
          "login",
          "password"
        ]
      }
    },
    "responses": {},
    "parameters": {},
    "securitySchemes": {}
  },
  "tags": [
    {
      "name": "Account Service",
      "description": "User authentication and account management service"
    }
  ],
  "x-services": [
    {
      "name": "Account Service",
      "version": "1.0.0",
      "pathPrefix": "/account-service"
    }
  ]
}