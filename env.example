# =============================================================================
# Vizonomy Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# Two logical databases on same postgres instance:
# - housing: shared_data_layer (documents, chunks, knowledge graph)
# - auth_db: auth-service (users, refresh tokens)
POSTGRES_DB=housing
AUTH_DB=auth_db
POSTGRES_USER=vizonomy_user
POSTGRES_PASSWORD=your-secure-password-here  # REQUIRED: Change this!
POSTGRES_PORT=5432

# Full connection URLs (auto-constructed in docker-compose, but useful for direct connections)
# Shared data layer (documents, chunks, etc.)
DATABASE_URL=postgresql://vizonomy_user:your-secure-password-here@localhost:5432/housing
# Auth service (users, tokens)
AUTH_DATABASE_URL=postgresql://vizonomy_user:your-secure-password-here@localhost:5432/auth_db

# =============================================================================
# JWT Configuration
# =============================================================================
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES=900           # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000      # 30 days in seconds
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15    # For services using minutes

# =============================================================================
# Service Ports (optional - defaults shown)
# =============================================================================
AUTH_SERVICE_PORT=5001
USER_SERVICE_PORT=5002
SWAGGER_SERVICE_PORT=3000

# =============================================================================
# Flask Configuration
# =============================================================================
FLASK_ENV=production
FLASK_DEBUG=False

# =============================================================================
# Node.js Configuration
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info

# =============================================================================
# Security
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:5002

# =============================================================================
# Email Configuration (for password reset - optional)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@vizonomy.com

# =============================================================================
# AWS Configuration (for Lambda/S3 integration)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=vizonomy-raw-documents

# =============================================================================
# Document Upload Service Configuration
# =============================================================================
MAX_FILE_SIZE_BYTES=104857600          # 100MB
PRESIGNED_URL_EXPIRY_SEC=900           # 15 minutes
