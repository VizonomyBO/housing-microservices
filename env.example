# =============================================================================
# Environment Template (copy to .env.local/.env.dev/.env.prod)
# =============================================================================
COMPOSE_PROJECT_NAME=housing
ENV_FILE=.env.local

# ----------------------------------------------------------------------------
# AWS & LocalStack
# ----------------------------------------------------------------------------
USE_LOCALSTACK=1
LOCALSTACK_HOST=localstack
LOCALSTACK_EDGE_PORT=4566
LOCALSTACK_SERVICES=s3,sns,sqs,secretsmanager,events
LOCALSTACK_DEBUG=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=http://localstack:4566

# ----------------------------------------------------------------------------
# Networking & Ports
# ----------------------------------------------------------------------------
POSTGRES_PORT=5432
AGENT_API_PORT=8000
AUTH_SERVICE_PORT=5001
USER_SERVICE_PORT=5002
INGESTION_SERVICE_PORT=8085

# ----------------------------------------------------------------------------
# Databases
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_DB=housing
AUTH_DB=auth_db
POSTGRES_USER=vizonomy_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
AUTH_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${AUTH_DB}
HOUSING_DATABASE_URL=${DATABASE_URL}
EMBEDDING_DIMENSION=1024

# ----------------------------------------------------------------------------
# Service URLs (host vs internal)
# ----------------------------------------------------------------------------
AGENT_BASE_URL=http://localhost:${AGENT_API_PORT}
AUTH_BASE_URL=http://localhost:${AUTH_SERVICE_PORT}
USER_BASE_URL=http://localhost:${USER_SERVICE_PORT}
INGEST_BASE_URL=http://localhost:${INGESTION_SERVICE_PORT}
AGENT_INGEST_BASE_URL=http://ingestion-service:8085
AUTH_SERVICE_URL=http://auth-service:5000
USER_SERVICE_URL=http://user-service:5001
AUTH_INTERNAL_BASE_URL=http://auth-service:5000

# ----------------------------------------------------------------------------
# Auth / App Secrets
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
AUTH_SHARED_SECRET=${JWT_SECRET_KEY}
AUTH_JWT_ISSUER=${AUTH_INTERNAL_BASE_URL}
AUTH_JWT_AUDIENCE=agent-api
AUTH_JWT_ALGORITHMS=RS256,HS256
AUTH_JWKS_URL=
AUTH_JWKS_CACHE_SECONDS=3600
AUTH_JWT_LEEWAY_SECONDS=60
AUTH_REQUIRED_SCOPES=
AUTH_SCOPE_CLAIM=scope
AUTH_TENANT_CLAIM=tenant_id
ENABLE_SIMPLE_GUARDS=true
PASSWORD_RESET_URL=http://localhost:3000/reset-password
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AGENT_API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AGENT_API_CORS_ALLOW_CREDENTIALS=false
NODE_ENV=production
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# LLM / Retrieval
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-context-3
VOYAGE_EMBEDDING_DIMENSIONS=1024
VOYAGE_RERANK_MODEL=rerank-2.5
VOYAGE_OUTPUT_DIMENSION=1024

# ----------------------------------------------------------------------------
# Ingestion & Storage
# ----------------------------------------------------------------------------
INGEST_UPLOAD_API_KEY=
SIGNING_SECRET=
RAW_DOCUMENTS_BUCKET=housing-raw-dev
PROCESSED_BUCKET=housing-processed-dev

# ----------------------------------------------------------------------------
# Metrics
# ----------------------------------------------------------------------------
METRICS_NAMESPACE=agent-api
METRICS_AUTH_HEADER=Authorization
METRICS_AUTH_SCHEME=Bearer
METRICS_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Demo/Test User (used by smoke scripts)
# ----------------------------------------------------------------------------
PROD_DEMO_EMAIL=demo.client@example.com
PROD_DEMO_USERNAME=demo_client
PROD_DEMO_PASSWORD=ChangeMe!123
PROD_DEMO_FIRST_NAME=Demo
PROD_DEMO_LAST_NAME=Client
PROD_DEMO_COUNTRY=USA
PROD_DEMO_TAG=demo
