# Database Configuration
DATABASE_URL=postgresql://account_user:secure_password@postgres:5432/account_db
POSTGRES_DB=account_db
POSTGRES_USER=account_user
POSTGRES_PASSWORD=secure_password

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# TypeScript Swagger Service Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ACCOUNT_SERVICE_URL=http://account-service:5000

# Security
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Email Configuration (for password reset) - AWS SES
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
EMAIL_FROM=noreply@yourapp.com

# Legacy SMTP (not used, kept for backwards compatibility)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

