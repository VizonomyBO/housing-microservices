{
  "Comment": "Document Ingestion Pipeline - Transforms raw documents into vectors and structured artifacts with progress tracking.",
  "StartAt": "CaptureRequest",
  "States": {
    "CaptureRequest": {
      "Type": "Pass",
      "Comment": "Preserve the original upload payload so optional fields (callback_url, tags, etc.) remain available",
      "ResultPath": "$.request",
      "Next": "EmitConvertStarted"
    },
    "EmitConvertStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "convert",
              "status": "started",
              "percent_complete": 10,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "Convert"
    },
    "Convert": {
      "Type": "Task",
      "Comment": "Convert PDF/DOCX to Markdown using markitdown Lambda",
      "Resource": "${MarkerConverterLambdaArn}",
      "Parameters": {
        "document_id.$": "$.document_id",
        "ingestion_id.$": "$.ingestion_id",
        "bucket.$": "$.bucket",
        "key.$": "$.key",
        "source_type.$": "$.source_type",
        "trace_id.$": "$.trace_id"
      },
      "ResultPath": "$.convert_result",
      "Retry": [
        {
          "ErrorEquals": ["ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DeadLetter"
        }
      ],
      "Next": "EmitConvertCompleted"
    },
    "EmitConvertCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "convert",
              "status": "completed",
              "percent_complete": 25,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "EmitChunkStarted"
    },
    "EmitChunkStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "chunk",
              "status": "started",
              "percent_complete": 30,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "Chunk"
    },
    "Chunk": {
      "Type": "Task",
      "Comment": "Split converted content into semantic chunks (~500 tokens)",
      "Resource": "${ChunkBuilderLambdaArn}",
      "Parameters": {
        "ingestion_id.$": "$.ingestion_id",
        "document_id.$": "$.document_id",
        "country_code.$": "$.country_code",
        "language.$": "$.language",
        "markdown_key.$": "$.convert_result.markdown_key",
        "structured_json_key.$": "$.convert_result.structured_json_key",
        "trace_id.$": "$.trace_id"
      },
      "ResultPath": "$.chunk_result",
      "Retry": [
        {
          "ErrorEquals": ["ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DeadLetter"
        }
      ],
      "Next": "EmitChunkCompleted"
    },
    "EmitChunkCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "chunk",
              "status": "completed",
              "percent_complete": 45,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "ParallelProcessing"
    },
    "ParallelProcessing": {
      "Type": "Parallel",
      "Comment": "Process tables, images in parallel",
      "Branches": [
        {
          "StartAt": "NormalizeTables",
          "States": {
            "NormalizeTables": {
              "Type": "Task",
              "Comment": "Normalize table blocks to structured JSON",
              "Resource": "${TableNormalizerLambdaArn}",
              "Parameters": {
                "ingestion_id.$": "$.ingestion_id",
                "document_id.$": "$.document_id",
                "structured_json_key.$": "$.convert_result.structured_json_key",
                "trace_id.$": "$.trace_id"
              },
              "ResultPath": "$.table_result",
              "Retry": [
                {
                  "ErrorEquals": ["ThrottlingException", "ServiceException"],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 5,
                  "BackoffRate": 1.5
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "CaptionImages",
          "States": {
            "CaptionImages": {
              "Type": "Task",
              "Comment": "Generate captions for figure/image blocks",
              "Resource": "${FigureCaptionerLambdaArn}",
              "Parameters": {
                "ingestion_id.$": "$.ingestion_id",
                "document_id.$": "$.document_id",
                "structured_json_key.$": "$.convert_result.structured_json_key",
                "trace_id.$": "$.trace_id"
              },
              "ResultPath": "$.caption_result",
              "Retry": [
                {
                  "ErrorEquals": ["LLMTimeoutError"],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 1,
                  "BackoffRate": 1.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallel_results",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DeadLetter"
        }
      ],
      "Next": "EmitEmbedStarted"
    },
    "EmitEmbedStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "embed",
              "status": "started",
              "percent_complete": 60,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "Embed"
    },
    "Embed": {
      "Type": "Task",
      "Comment": "Generate embeddings (placeholder - Task 2.3)",
      "Resource": "${EmbeddingWriterLambdaArn}",
      "Parameters": {
        "ingestion_id.$": "$.ingestion_id",
        "document_id.$": "$.document_id",
        "trace_id.$": "$.trace_id"
      },
      "ResultPath": "$.embed_result",
      "Retry": [
        {
          "ErrorEquals": ["VoyageRateLimitError", "VoyageServiceError"],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": ["DatabaseTransientError"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DeadLetter"
        }
      ],
      "Next": "EmitEmbedCompleted"
    },
    "EmitEmbedCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "embed",
              "status": "completed",
              "percent_complete": 80,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "EmitIndexStarted"
    },
    "EmitIndexStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "index",
              "status": "started",
              "percent_complete": 85,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "Index"
    },
    "Index": {
      "Type": "Task",
      "Comment": "Index chunks (placeholder - Task 2.3)",
      "Resource": "${IndexRefresherLambdaArn}",
      "Parameters": {
        "ingestion_id.$": "$.ingestion_id",
        "document_id.$": "$.document_id",
        "trace_id.$": "$.trace_id"
      },
      "ResultPath": "$.index_result",
      "Retry": [
        {
          "ErrorEquals": ["DatabaseTransientError"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DeadLetter"
        }
      ],
      "Next": "EmitIndexCompleted"
    },
    "EmitIndexCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "index",
              "status": "completed",
              "percent_complete": 90,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "EmitActivateStarted"
    },
    "EmitActivateStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.progress",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "stage": "activate",
              "status": "started",
              "percent_complete": 95,
              "trace_id.$": "$.trace_id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "ResultPath": null,
      "Next": "Activate"
    },
    "Activate": {
      "Type": "Task",
      "Comment": "Update document status to active",
      "Resource": "${IngestionFinalizerLambdaArn}",
      "Parameters": {
        "ingestion_id.$": "$.ingestion_id",
        "document_id.$": "$.document_id",
        "trace_id.$": "$.trace_id",
        "timestamps": {
          "started_at.$": "$$.Execution.StartTime",
          "completed_at.$": "$$.State.EnteredTime"
        }
      },
      "ResultPath": "$.activate_result",
      "Retry": [
        {
          "ErrorEquals": ["ServiceException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1,
          "BackoffRate": 1.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DeadLetter"
        }
      ],
      "Next": "EmitCompletionEvent"
    },
    "EmitCompletionEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.completed",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "content_hash.$": "$.content_hash",
              "access_scope.$": "$.access_scope",
              "chunk_count.$": "$.chunk_result.chunk_count",
              "percent_complete": 100,
              "execution_arn.$": "$$.Execution.Id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "End": true
    },
    "DeadLetter": {
      "Type": "Task",
      "Comment": "Handle failed ingestions - update status and emit failure event",
      "Resource": "${IngestionFinalizerLambdaArn}",
      "Parameters": {
        "ingestion_id.$": "$.ingestion_id",
        "document_id.$": "$.document_id",
        "status": "failed",
        "error.$": "$.error",
        "trace_id.$": "$.trace_id",
        "callback_url": null
      },
      "ResultPath": "$.dlq_result",
      "Next": "EmitFailureEvent"
    },
    "EmitFailureEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "vizonomy.ingestion",
            "DetailType": "ingestion.failed",
            "Detail": {
              "ingestion_id.$": "$.ingestion_id",
              "document_id.$": "$.document_id",
              "failed_state": "unknown",
              "error_name.$": "$.error.Error",
              "error_code.$": "$.error.Cause",
              "will_retry": false,
              "execution_arn.$": "$$.Execution.Id"
            },
            "EventBusName": "${EventBusName}"
          }
        ]
      },
      "End": true
    }
  }
}
