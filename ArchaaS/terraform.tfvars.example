# =============================================================================
# Vizonomy Infrastructure - Example Terraform Variables
# =============================================================================
# Copy this to terraform.tfvars and update with your values

# Basic Configuration
aws_region   = "us-east-1"
project_name = "vizonomy"
environment  = "dev"

# =============================================================================
# VPC Configuration (required)
# =============================================================================
vpc_id             = "vpc-xxxxxxxx"
private_subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]

# CORS Allowed Origins
allowed_origins = [
  "https://app.vizonomy.com",
  "https://staging.vizonomy.com",
  "http://localhost:3000"
]

# =============================================================================
# EC2 Configuration (Microservices + PostgreSQL Host)
# =============================================================================
# Instance type: t3.medium is a good balance for dev/test
# - t3.micro: Testing only (2 vCPU, 1GB RAM)
# - t3.small: Light dev (2 vCPU, 2GB RAM)
# - t3.medium: Dev/staging (2 vCPU, 4GB RAM) - RECOMMENDED
# - t3.large: Production (2 vCPU, 8GB RAM)
ec2_instance_type = "t3.medium"

# SSH Key Pair (create in AWS Console → EC2 → Key Pairs)
ec2_key_pair_name = "vizonomy-dev-key"

# Network configuration
ec2_public_ip = true  # Set to false if using NAT Gateway

# Storage (30GB is usually enough for dev)
ec2_volume_size = 30

# Elastic IP for stable addressing (recommended for production)
create_elastic_ip = false

# SSH access - IMPORTANT: Restrict in production!
ssh_allowed_cidrs = ["YOUR_IP/32"]  # e.g., ["203.0.113.0/32"]

# VPC CIDR blocks for internal service access
vpc_cidr_blocks = ["10.0.0.0/8"]

# =============================================================================
# Database Configuration (runs on EC2)
# =============================================================================
# Two logical databases on same postgres instance:
# - housing: shared_data_layer (documents, chunks, knowledge graph)
# - auth_db: auth-service (users, refresh_tokens)
#
# This separation allows:
# - Independent scaling and backup strategies
# - Clear ownership boundaries between services
# - Cross-database references use UUIDs (no FK constraints)
database_name      = "housing"
auth_database_name = "auth_db"
database_username  = "vizonomy_user"
database_password  = "your-secure-password-here"  # Change this!
database_port      = 5432

# Store credentials in AWS Secrets Manager (recommended)
create_database_secret = true

# =============================================================================
# Lambda Configuration
# =============================================================================
log_level                = "INFO"
log_retention_days       = 30
presigned_url_expiry_sec = 900          # 15 minutes
max_file_size_bytes      = 104857600    # 100MB

# =============================================================================
# API Gateway Configuration
# =============================================================================
api_throttle_burst_limit = 100
api_throttle_rate_limit  = 50

# JWT Authorization (from your auth service running on EC2)
jwt_audience = ["vizonomy-api"]
jwt_issuer   = "http://EC2_PUBLIC_IP:5001"  # Update after deployment

# =============================================================================
# Git Repository (for EC2 deployment)
# =============================================================================
# The EC2 instance clones this repo and uses your docker-compose.yml
git_repo   = "https://github.com/VizonomyBO/housing-microservices.git"  # Your repo URL
git_branch = "master"

# For PRIVATE repos: Create a GitHub Personal Access Token (PAT)
# 1. Go to GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# 2. Generate new token with 'repo' scope
# 3. Paste here (keep secret!)
git_token  = ""  # Leave empty for public repos

# =============================================================================
# Custom Domain (optional)
# =============================================================================
custom_domain_name = ""
certificate_arn    = ""
openai_api_key